# Copy to .env and fill in. .env is gitignored and must never be committed.
# Lane D loads these on the API server. The iOS app, the browser, Git, prompts
# and Weave traces never see one.
#
# A key that shows up in chat, an issue, a log or a commit counts as leaked.
# Rotate it before using it.

# Astra and every other model call except labelling, via OpenRouter.
# Require zero data retention on the account and set a credit limit.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-opus-5.5
# Labelling each scanned object from the photos, direct against Fireworks with
# FIREWORKS_API_KEY below. Leave blank for DeepSeek v4.1 Flash; an unusable
# answer falls back to the local labels. Set anthropic/claude-opus-5.5 with
# OPENROUTER_BASE_URL to go through OpenRouter instead.
LABEL_MODEL=
# The fine-tuned labeller: Qwen3.8-27B trained on Opus's answers, served from
# Fireworks' Serverless Training pool with FIREWORKS_API_KEY at about $0.10 a
# shop. When set it takes over from LABEL_MODEL. Blank it to go back to
# LABEL_MODEL.
LABEL_STATE=amelia-team/run-6800718d223f45ec85e0eb34ead5a0dd/epoch-1

# Weave tracing and evaluation. ARIA reads the experiment grid from the same
# project, and only works in a team project with Smart features on: see
# docs/aria.md. The entity is the team or username the key belongs to; the API
# server reads both at startup and traces the run. Leave them empty and the
# server runs untraced.
WANDB_API_KEY=
WANDB_ENTITY=
WANDB_PROJECT=

# The router. Without a base URL the loop runs the local policy and labels it
# as one. The model is optional and defaults to jev-latest; GET /v1/models
# lists the names an account may use. The path defaults to /v1/systemone.
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_PATH=
TYPESAFE_MODEL=

# The stretch catalog, only if it gets built.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=

# Object discovery reads the photos. Any OpenAI-shaped chat endpoint that takes
# images and honours a strict JSON schema will do. Falls back to the OpenRouter
# values above when these are unset. Ships pointed at the same open-weights
# model as labelling, direct against Fireworks with FIREWORKS_API_KEY below.
DISCOVERY_API_KEY=
DISCOVERY_BASE_URL=https://api.fireworks.ai/inference/v1
DISCOVERY_MODEL=accounts/fireworks/models/deepseek-v4p1-flash

# The sample shop's demo account, when SP_SEED_SAMPLE_SHOP=1. Without a
# password here the server generates one on the run that creates the account
# and writes it to a file named demo-password in the data directory
# (SP_DATA_DIR), readable only by the server's user. The log says where.
SP_SEED_OWNER_EMAIL=demo@standardphysics.app
SP_SEED_OWNER_PASSWORD=

# Fireworks. Labelling and object discovery call it directly for LABEL_MODEL
# and DISCOVERY_MODEL above; "Suggest a rearrangement" below uses the same key
# for its own fine-tuned model. Leave SP_REARRANGE_MODEL empty and that button
# shows as off. The deployment is an on-demand one with min replicas 0; a
# suggestion lets it run one replica and scales it back to zero after
# SP_REARRANGE_KEEP_WARM_SECONDS. SP_REARRANGE_FAKE_MODEL=1 swaps in a local
# stand-in for development and makes no calls.
FIREWORKS_API_KEY=
SP_REARRANGE_MODEL=
SP_REARRANGE_DEPLOYMENT=
SP_REARRANGE_KEEP_WARM_SECONDS=300
SP_REARRANGE_FAKE_MODEL=
