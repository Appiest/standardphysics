# Copy to .env and fill in. .env is gitignored and must never be committed.
# Lane D loads these on the API server. The iOS app, the browser, Git, prompts
# and Weave traces never see one.
#
# A key that shows up in chat, an issue, a log or a commit counts as leaked.
# Rotate it before using it.

# Astra and every other model call, via OpenRouter.
# Require zero data retention on the account and set a credit limit.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-6-astra

# Weave tracing and evaluation. ARIA reads the experiment grid from the same
# project, and only works in a team project with Smart features on: see
# docs/aria.md. The entity is the team or username the key belongs to; the API
# server reads both at startup and traces the run. Leave them empty and the
# server runs untraced.
WANDB_API_KEY=
WANDB_ENTITY=
WANDB_PROJECT=

# The router. Without a base URL the loop runs the local policy and labels it
# as one. The model is optional and defaults to jev-latest; GET /v1/models
# lists the names an account may use.
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai
TYPESAFE_MODEL=

# Signing app sessions and upload tokens. Generate locally:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SESSION_SECRET=

# The stretch catalog, only if it gets built.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=

# Object discovery reads the photos. Any OpenAI-shaped chat endpoint that takes
# images and honours a strict JSON schema will do. Falls back to the OpenRouter
# values above when these are unset.
DISCOVERY_API_KEY=
DISCOVERY_BASE_URL=
DISCOVERY_MODEL=

# The sample shop's demo account, when SP_SEED_SAMPLE_SHOP=1. Without a
# password here the server generates one at startup and logs it.
SP_SEED_OWNER_EMAIL=demo@standardphysics.app
SP_SEED_OWNER_PASSWORD=
