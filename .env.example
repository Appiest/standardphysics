# Copy to .env and fill in. .env is gitignored and must never be committed.
# Lane D loads these on the API server. The iOS app, the browser, Git, prompts
# and Weave traces never see one.
#
# A key that shows up in chat, an issue, a log or a commit counts as leaked.
# Rotate it before using it.

# Astra and every other model call, via OpenRouter.
# Require zero data retention on the account and set a credit limit.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-6-astra

# Weave tracing and evaluation. ARIA uses the same team project. The entity is
# the team or username the key belongs to; the API server reads both at startup
# and traces the run. Leave them empty and the server runs untraced.
WANDB_API_KEY=
WANDB_ENTITY=
WANDB_PROJECT=

# The router.
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai

# Signing app sessions and upload tokens. Generate locally:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SESSION_SECRET=

# The stretch catalog, only if it gets built.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
