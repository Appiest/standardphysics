      "min_fraction_supported_target_pixels_meeting_both": 0.95,
      "critical_roi_target_samples_per_output_pixel_linear": 2.0,
      "measurement": "local projection and UV Jacobians, weaker linear axis, native source size and active mip level; no credit for upsampling",
