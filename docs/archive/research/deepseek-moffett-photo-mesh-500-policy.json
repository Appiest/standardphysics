    "coverage": {
      "min_photographed_target_pixel_fraction_each_view": 0.95,
      "min_photographed_critical_roi_fraction_each": 0.98,
      "max_single_untextured_hole_target_pixel_fraction": 0.01,
      "max_new_untextured_hole_fraction_vs_baseline": 0.0,
      "source_supported_subset_and_total_reported_separately": true,
      "unknown_and_inpainted_regions_count_as_observed": false,
      "critical_roi_may_be_removed_after_failure": false
