      "require_motion_review_for_seams_flicker_and_popping": true,
      "agent_review_status": "provisional_agent_reviewed",
      "user_review_required_for_user_accepted": true,
      "missing_user_review_status": "pending"
    }
  },
  "supporting_metrics": {
