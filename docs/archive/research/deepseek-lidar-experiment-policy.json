{
  "schema_version": 1,
  "kind": "proposed_experiment_policy_not_measured_results",
  "created_date": "2026-09-20",
  "freeze_before_candidates": true,
  "threshold_note": "Engineering acceptance defaults, not empirical guarantees or measurement accuracy. Any evaluator/policy correction creates a new benchmark version and requires affected results to be recomputed.",
  "scope": {
    "hardware": "verify local Apple Silicon",
    "cuda_allowed": false,
    "paid_compute_allowed": false,
    "automatic_production_replacement": false,
    "modify_originals": false,
    "resume_old_automation": false,
    "push_commits": false
  },
  "budgets": {
    "total_minutes": 480,
    "reserved_handoff_minutes": 60,
    "max_heavy_gpu_jobs": 1,
    "max_candidate_configurations": 8,
    "baseline_excluded_from_configuration_cap": true,
    "repeat_trials_excluded_from_configuration_cap": true,
    "max_repairs_per_gate_hypothesis": 3,
    "max_hypotheses_per_blocker": 2,
    "backend_setup_minutes": 45,
    "pilot_training_minutes": 20,
    "pilot_training_steps": 7000,
    "training_ends_at_first_limit": true,
    "refinement_minutes": 5,
    "process_footprint_cap_gib": 24,
    "physical_memory_fraction_cap": 0.5,
    "effective_memory_cap_rule": "min(process_footprint_cap_gib, physical_memory_gib * physical_memory_fraction_cap)",
    "job_poll_seconds": [15, 30],
    "checkpoint_max_interval_minutes": 10,
    "plateau_trial_count": 3,
    "plateau_min_validation_score_gain": 2.0,
    "final_test_finalists": 1
  },
  "pilot": {
    "training_view_target": 32,
    "validation_view_target": 8,
    "final_test_view_target": 8,
    "view_counts_are_targets_not_independence_proof": true,
    "split_unit": "reviewed separated trajectory/viewpoint groups",
    "max_image_edge_px": 1280,
    "preserve_aspect_ratio": true,
    "seed": 1729,
    "shared_aggregate_lidar_must_be_disclosed": true,
    "evaluation_rgb_may_train_or_bake": false,
    "evaluation_masks_may_derive_from_candidate": false,
    "measured_baseline": "new matched Brush pilot",
    "historical_baseline_use": "visual context only unless equivalence and leakage checks pass"
  },
  "surface_builder": {
    "initial_sample_cap": 150000,
    "optional_sample_cap": 300000,
    "initial_top_k": 4,
    "optional_top_k": 8,
    "point_block_size": 8192,
    "initial_sh_degree": 0,
    "initial_centers_fixed": true,
    "initial_color": "best_valid_source_view",
    "synthetic_tangent_sigma_spacing_factors": [0.5, 0.75, 1.0],
    "initial_normal_to_min_tangent_ratio": 0.1,
    "optional_normal_ratio_one_factor_trials": [0.05, 0.2],
    "max_tangent_anisotropy": 3.0,
    "synthetic_opacity_options": [0.3, 0.5, 0.7],
    "tangent_scale_and_opacity_freeze_after_synthetic_tests": true,
    "optional_refinement_steps": [0, 100, 500],
    "unknown_visibility": "reject_or_mark_unknown_not_visible",
    "unobserved_photographic_samples": "prune",
    "surface_parameters_are_accuracy_claims": false
  },
  "measurement": {
    "baseline_and_each_scored_candidate_repeats": 3,
    "single_run_smoke_trial_can_have_eligible_score": false,
    "run_order": "alternate baseline and candidate",
    "cold_scope": "fresh derived caches plus required preprocessing, build/train and compressed export; disclose OS cache limitations",
    "timing_aggregate": "median",
    "footprint_aggregate": "maximum comparable measured peak across repeats",
    "compressed_size_aggregate": "maximum SPZ bytes across repeats",
    "viewer_sessions": 3,
    "viewer_warmup_seconds": 10,
    "viewer_path_seconds": 60,
    "viewer_metric": "worst session p95 actual rendered-frame time",
    "coverage_alpha_threshold": 0.5,
    "coverage_denominator": "frozen known-photo-supported evaluation pixels",
    "metric_rgb": "decoded sRGB float64 [0,1]",
    "psnr_mse_floor": 1e-10,
    "ssim": {
      "gaussian_weights": true,
      "window_size": 11,
      "sigma": 1.5,
      "data_range": 1.0,
      "sample_covariance": false,
      "channel_reduction": "mean RGB"
    },
    "ssim_mask_rule": "full-image SSIM map; include only windows wholly inside fixed valid mask",
    "lpips_role": "optional fixed diagnostic; not weighted score",
    "bootstrap_group": "independent trajectory group",
    "bootstrap_resamples": 1000,
    "bootstrap_seed": 1729,
    "novel_seated_eye_height_m": 1.15,
    "seated_views_have_rgb_ground_truth": false,
    "missing_metric": "null_with_reason_and_ineligible"
  },
  "hard_numeric_gates": {
    "max_mean_psnr_drop_db": 0.2,
    "max_mean_full_frame_psnr_drop_db": 0.5,
    "max_mean_ssim_drop": 0.005,
    "max_each_critical_roi_psnr_drop_db": 0.3,
    "max_each_view_psnr_drop_db": 1.0,
    "max_supported_uncovered_fraction_increase": 0.01,
    "max_frame_p95_ratio_candidate_to_baseline": 1.1
  },
  "hard_non_numeric_gates": [
    "frozen_input_split_evaluator_and_artifact_hashes_validate",
    "originals_and_previous_revisions_preserved",
    "authoritative_measured_mesh_graph_and_fallback_inventory_preserved",
    "calibration_axes_color_export_and_required_tests_pass",
    "all_expected_views_and_rois_present_no_nonfinite_metrics",
    "no_disappeared_critical_feature_or_new_misleading_surface",
    "no_new_or_worse_person_ghost_on_paired_visual_review",
    "footprint_cap_and_comparable_cost_measurement_pass",
    "measured_collision_export_auth_and_revision_boundaries_preserved"
  ],
  "score": {
    "compute_only_if_all_gates_pass": true,
    "unknown_gate_is_pass": false,
    "baseline_score": 50.0,
    "minimum_selection_score": 55.0,
    "clip_definition": "min(1,max(0,x))",
    "q_psnr": "clip(0.5 + (candidate_mean_psnr_db - baseline_mean_psnr_db) / 2.0)",
    "q_ssim": "clip(0.5 + (candidate_mean_ssim - baseline_mean_ssim) / 0.04)",
    "q_critical": "clip(0.5 + minimum_preregistered_roi_psnr_delta_db / 2.0)",
    "quality": "100 * (0.40*q_psnr + 0.30*q_ssim + 0.30*q_critical)",
    "resource_gain": "100*clip(0.5 + log2(baseline/candidate)/2.0); positive finite inputs required",
    "weights": {
      "quality": 0.6,
      "cold_end_to_end_seconds": 0.2,
      "peak_footprint_bytes": 0.08,
      "compressed_spz_bytes": 0.07,
      "rendered_frame_p95_ms": 0.05
    },
    "do_not_reweight_missing_components": true,
    "score_does_not_imply_photorealism": true
  },
  "selection_lanes": {
    "quality": {
      "min_mean_psnr_improvement_db": 0.5,
      "min_mean_ssim_improvement": 0.01,
      "max_time_ratio_candidate_to_baseline": 1.25,
      "max_footprint_ratio_candidate_to_baseline": 1.1,
      "max_spz_size_ratio_candidate_to_baseline": 1.25
    },
    "efficiency": {
      "min_time_ratio_baseline_to_candidate": 1.5,
      "max_footprint_ratio_candidate_to_baseline": 1.0,
      "max_spz_size_ratio_candidate_to_baseline": 1.0
    },
    "require_all_hard_gates_and_minimum_score_and_one_lane": true,
    "timing_claim_must_exceed_observed_noise": true,
    "final_test_cannot_be_used_for_tuning": true,
    "second_area_transfer_required_before_full_room_claim": true
  },
  "evidence": {
    "metric_values_written_by": "evaluator_from_actual_artifacts_not_language_model",
    "visual_review_identity_required": true,
    "labeled_agent_self_review_allowed_for_experiments": true,
    "appearance_coverage_is_independent_geometry_validation": false,
    "required_run_records": [
      "input_manifest_and_hashes",
      "config_and_hash",
      "code_and_evaluator_version_hashes",
      "exact_command_exit_status_and_logs",
      "resource_trace_and_measurement_scope",
      "output_artifacts_and_hashes",
      "per_view_metrics_and_expected_view_list",
      "hard_gate_results_with_evidence_paths",
      "paired_renders_and_review_identity",
      "conclusion_and_failure_reasons"
    ],
    "same_agent_hashes_are_tamper_proof": false,
    "physical_phone_test_can_be_replaced_by_viewport_emulation": false,
    "incomplete_overall_goal_must_remain_explicit": true
  }
}
