# Copy to .env on the Droplet and fill in. Never commit the filled-in copy.
#
# docker compose reads this file from the directory it runs in, and the API
# container reads the same file for its keys.

# The two names in DNS, both pointing at this Droplet's IP. Caddy gets a
# certificate for each one, so they have to resolve before the first start.
API_DOMAIN=api.standardphysics.app
APP_DOMAIN=standardphysics.app

# Where the Block Storage volume is mounted. setup.sh prints this.
SCANS_PATH=/mnt/standardphysics-scans

# Signing app sessions and upload tokens. Generate on the Droplet:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SESSION_SECRET=

# Astra and every other model call, via OpenRouter.
# Require zero data retention on the account and set a credit limit.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-6-astra

# Object discovery reads the photos. Falls back to the OpenRouter values when
# these are unset.
DISCOVERY_API_KEY=
DISCOVERY_BASE_URL=
DISCOVERY_MODEL=

# Tracing. Leave empty on a deployment holding real shops.
WANDB_API_KEY=
WANDB_ENTITY=
WANDB_PROJECT=

# The team's own accounts, comma separated. They see developer mode, scoped
# checks and the photo review queue; every other account is a shop owner.
SP_TEAM_EMAILS=

# Push notifications through Apple. Make a key with the Apple Push Notifications
# service enabled under Certificates, Identifiers & Profiles > Keys. The API
# container only sees the scan volume, which it calls /data, so copy the .p8 to
# $SCANS_PATH/keys/ on the Droplet, chown it to 10001 and give the path as the
# container sees it, like /data/keys/AuthKey_ABC123DEFG.p8. With no key, or one
# the container can't read, the server logs each push instead of sending it.
SP_APNS_KEY_PATH=
SP_APNS_KEY_ID=
SP_APNS_TEAM_ID=K4Z2L5279D

# App ids a Sign in with Apple token may be issued for. The iPhone app's bundle
# id is the default.
SP_APPLE_AUDIENCES=com.standardphysics.capture
