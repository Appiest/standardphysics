# Copy to .env on the Droplet and fill in. Never commit the filled-in copy.
#
# docker compose reads this file from the directory it runs in, and the API
# container reads the same file for its keys.

# The two names in DNS, both pointing at this Droplet's IP. Caddy gets a
# certificate for each one, so they have to resolve before the first start.
API_DOMAIN=api.standardphysics.app
APP_DOMAIN=standardphysics.app

# Where the Block Storage volume is mounted. setup.sh prints this.
SCANS_PATH=/mnt/standardphysics-scans

# Allows the team to export beta addresses for TestFlight invitations. Generate a random token:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SP_WAITLIST_ADMIN_TOKEN=
# Astra and every other model call, via OpenRouter.
# Require zero data retention on the account and set a credit limit.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-opus-5.5
# Labelling each scanned object from the photos. Leave unset for Opus 5.5, which
# labels a shop for about $0.75; a pricier model can push a scan past $1.50.
LABEL_MODEL=

# Object discovery reads the photos. Falls back to the OpenRouter values when
# these are unset.
DISCOVERY_API_KEY=
DISCOVERY_BASE_URL=
DISCOVERY_MODEL=

# Tracing. Leave empty on a deployment holding real shops.
WANDB_API_KEY=
WANDB_ENTITY=
WANDB_PROJECT=

# The team's accounts from before the team was a role, comma separated. Read
# once per database, to grant the role to the saved accounts with these emails.
# Grant or revoke it afterwards from the Droplet with
#   docker compose exec api /opt/venv/bin/python -m standardphysics_api.team grant someone@standardphysics.app
# Team accounts see developer mode, scoped checks and the photo review queue;
# every other account is a shop owner.
SP_TEAM_EMAILS=

# Push notifications through Apple. Make a key with the Apple Push Notifications
# service enabled under Certificates, Identifiers & Profiles > Keys. The API
# container only sees the scan volume, which it calls /data, so copy the .p8 to
# $SCANS_PATH/keys/ on the Droplet, chown it to 10001 and give the path as the
# container sees it, like /data/keys/AuthKey_ABC123DEFG.p8. With no key, or one
# the container can't read, the server logs each push instead of sending it.
SP_APNS_KEY_PATH=
SP_APNS_KEY_ID=
SP_APNS_TEAM_ID=K4Z2L5279D

# App ids a Sign in with Apple token may be issued for. The iPhone app's bundle
# id is the default.
SP_APPLE_AUDIENCES=com.standardphysics.capture

# Where backup.sh keeps its nightly snapshots of the database and the scans.
# A full path on this machine, or host:path on another reached over ssh with
# rsync installed there. An object store will not do; backup-lib.sh says why.
# Put it on a different disk from SCANS_PATH, or the copy dies with the
# original. The nightly timer stays off until this is set.
SP_BACKUP_DEST=
# How many snapshots to keep. Unchanged files are shared between snapshots,
# so each one costs only what changed since the one before.
SP_BACKUP_KEEP=14

# Where monitor.sh sends a message when a check starts failing or recovers.
# An ntfy topic, like https://ntfy.sh/<a long unguessable topic>, arrives as a
# push on any phone subscribed to it in the ntfy app. Anything else gets a
# JSON POST of {"text": "..."}, which a Slack incoming webhook accepts. The
# five-minute timer stays off until this is set. SP_ALERT_FORMAT=ntfy sends
# the ntfy way to a self-hosted ntfy server.
SP_ALERT_WEBHOOK=
SP_ALERT_FORMAT=
# Thresholds, with their defaults: the oldest queued job's wait in seconds,
# the scans volume's free space in percent, and the newest snapshot's age in
# hours (checked only when SP_BACKUP_DEST is set).
SP_MONITOR_QUEUE_SECONDS=1800
SP_MONITOR_MIN_FREE_PERCENT=15
SP_MONITOR_BACKUP_HOURS=26
