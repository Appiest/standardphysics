# TLS, and the only thing on the box listening to the internet.
#
# Two names rather than one path-routed name. The phone uploads a scan bundle
# that may reach the gigabyte ceiling in Settings.max_artifact_bytes, and
# pushing that through the workspace's Next rewrite would buy nothing and cost
# a hop. So the phone talks to the API and the browser talks to the workspace.
#
# Caddy gets a certificate from Let's Encrypt on first boot and renews it
# without being asked. That needs port 80 reachable and the DNS already
# pointing here.

{$API_DOMAIN} {
	reverse_proxy api:8787 {
		# A slow walk around a big shop uploads for a long time on shop Wi-Fi.
		transport http {
			read_timeout 30m
			write_timeout 30m
		}
	}
	request_body {
		max_size 1GB
	}
}

{$APP_DOMAIN} {
	reverse_proxy web:3000 {
		# Reconstruction can hold a request open while a model call finishes,
		# which next.config.ts already allows three minutes for.
		transport http {
			read_timeout 5m
			write_timeout 5m
		}
	}
}
