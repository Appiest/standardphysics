    {
      "case_id": "US-CAND-2021-CV-03481",
      "landmark_citation": "Johnson v. Golden State Warriors LLC, 2021 WL 4805441 (N.D. Cal. 2021)",
      "title": "VIP Dining Lounge Bar Counter Height & Integrated Seating",
      "year": 2021,
      "jurisdiction": "N.D. Cal.",
      "trigger": {
        "space_typologies": [
          "commercial.restaurant.dining",
          "commercial.hospitality.lounge"
        ],
        "required_entities": [
          "bar_counter",
          "high_top_table",
          "counter_stool",
          "dining_surface"
        ],
        "spatial_conditions": [
          "elevated_drink_surfaces_present"
        ]
      },
      "inspection_queries": [
        {
          "query_id": "bar_counter_accessible_section",
          "target_role": "bar_counter",
          "metric": "height_inches",
          "threshold": 34.0,
          "comparison": "at_most",
          "citation": "ADA_2010_904.4.1"
        },
        {
          "query_id": "dining_surface_knee_clearance",
          "target_role": "dining_surface",
          "metric": "knee_clearance_inches",
          "threshold": 27.0,
          "comparison": "at_least",
          "citation": "ADA_2010_306.3"
        },
        {
          "query_id": "accessible_seating_ratio",
          "target_role": "dining_surface",
          "metric": "accessible_ratio",
          "threshold": 0.05,
          "comparison": "ratio_at_least",
          "citation": "ADA_2010_226.1"
        }
      ],
      "constraints": {
        "forbidden_moves": [
          "do_not_move_fixed_bar_plumbing",
          "do_not_move_structural_columns"
        ],
        "solution_pattern": "provide_accessible_dining_surface_in_same_ambiance_zone",
        "minimum_accessible_percentage": 0.05,
        "anti_isolation": true
      },
      "plain_english_warning": "In VIP dining and lounge areas with bar-height counters, providing only high-top seating without accessible tables violates ADA § 226.1 and triggers automatic California Unruh statutory penalties. You must provide at least 5% accessible seating (28-34 inches high with 27-inch knee clearance) integrated directly into the guest lounge experience, not isolated near a service corridor.",
      "verified_by": "Yan Zihao"
    },
