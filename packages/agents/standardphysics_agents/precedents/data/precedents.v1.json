{
  "version": "2.0.0",
  "precedents": [
    {
      "directive_id": "service_counter",
      "title": "Ordering counter height, length and approach",
      "authority": ["ADA_2010_904.4", "ADA_2010_904.4.1", "ADA_2010_305.7.2", "ADA_2010_904.5.1"],
      "trigger": {
        "space_typologies": ["commercial.beverage.boba", "commercial.restaurant.dining", "commercial.retail.mercantile"],
        "required_entities": ["service_counter", "ordering_counter", "point_of_sale", "straw_dispenser"]
      },
      "inspection_queries": [
        {"query_id": "service_counter_height", "target_role": "service_counter", "metric": "height_inches", "threshold": 36.0, "comparison": "at_most", "citation": "ADA_2010_904.4.1", "rule_id": "service_counter_height"},
        {"query_id": "service_counter_clear_length", "target_role": "service_counter", "metric": "clear_length_inches", "threshold": 36.0, "comparison": "at_least", "citation": "ADA_2010_904.4.1", "rule_id": "service_counter_height"},
        {"query_id": "service_counter_approach_width", "target_role": "service_counter", "metric": "clear_width_inches", "threshold": 48.0, "comparison": "at_least", "citation": "ADA_2010_305.3", "rule_id": "service_counter_approach"},
        {"query_id": "service_counter_alcove_width", "target_role": "service_counter_alcove", "metric": "clear_width_inches", "threshold": 60.0, "comparison": "at_least", "citation": "ADA_2010_305.7.2"},
        {"query_id": "self_service_dispenser_reach", "target_role": "straw_dispenser", "metric": "reach_inches", "threshold": 48.0, "comparison": "at_most", "citation": "ADA_2010_308.2.1", "rule_id": "reach_range"}
      ],
      "constraints": {
        "fixed_roles": ["service_counter", "point_of_sale"],
        "solution_pattern": "clear_36_inch_counter_section_and_open_parallel_approach"
      },
      "plain_english_warning": "Part of the ordering counter must be no higher than 36 inches and at least 36 inches long, and that length has to stay clear of registers, tip jars and impulse-buy displays. If displays in front of the counter form an alcove more than 15 inches deep, it must be at least 60 inches wide so a wheelchair can pull up alongside. Self-serve straws, lids and napkins go within 48 inches of the floor.",
      "case_references": [
        {
          "citation": "81 F. Supp. 3d 876 (N.D. Cal. 2015)",
          "case_name": "Kalani v. Starbucks Corp.",
          "court": "N.D. Cal.",
          "decided": "2015-02-25",
          "docket_number": "13-cv-00734-LHK",
          "source_url": "https://www.courtlistener.com/opinion/7311599/kalani-v-starbucks-corp/",
          "holding": "Summary judgment for the plaintiff on the point-of-sale counter. Registers and promotional items kept the usable counter under the 36 inch length 904.4.1 requires, and display baskets in front formed an alcove deeper than 15 inches and narrower than 60 inches (305.7.2). The court refused to treat items the store routinely placed there as temporary obstructions under 28 C.F.R. 36.211(b).",
          "verified_by": null,
          "verified_at": null
        }
      ]
    },
    {
      "directive_id": "circulation_clear_width",
      "title": "Movable displays and furniture on the accessible route",
      "authority": ["ADA_2010_403.5.1"],
      "trigger": {
        "space_typologies": ["commercial.retail.mercantile", "commercial.restaurant.dining", "commercial.beverage.boba", "civic.library.reading_room"],
        "required_entities": ["merchandise_display", "display_case", "clothing_rack", "shelf", "table", "chair"]
      },
      "inspection_queries": [
        {"query_id": "route_clear_width", "target_role": "route_leg", "metric": "clear_width_inches", "threshold": 36.0, "comparison": "at_least", "citation": "ADA_2010_403.5.1", "rule_id": "route_clear_width"}
      ],
      "constraints": {
        "solution_pattern": "keep_36_inch_route_clear_of_movable_items"
      },
      "plain_english_warning": "The path through the shop must stay 36 inches wide, with pinches down to 32 inches allowed for no more than 24 inches of length. Display cases, racks and pulled-out chairs count, even though they can be moved, when they sit in the path as a matter of routine.",
      "case_references": [
        {
          "citation": "779 F.3d 1001 (9th Cir. 2015)",
          "case_name": "Chapman v. Pier 1 Imports (U.S.) Inc.",
          "court": "9th Cir.",
          "decided": "2015-03-05",
          "docket_number": "12-16857",
          "source_url": "https://www.courtlistener.com/opinion/2784335/chapman-v-pier-1-imports-us-inc/",
          "holding": "Affirmed summary judgment that a store violated Title III by repeatedly letting merchandise obstruct its aisles. Obstructions that recur are not the isolated or temporary interruptions 28 C.F.R. 36.211(b) excuses. The court reversed on the sales counter claim.",
          "verified_by": null,
          "verified_at": null
        }
      ]
    },
    {
      "directive_id": "accessible_dining_surfaces",
      "title": "Accessible dining surfaces and where they sit",
      "authority": ["ADA_2010_226.1", "ADA_2010_226.2", "ADA_2010_902.3", "ADA_2010_306.3"],
      "trigger": {
        "space_typologies": ["commercial.restaurant.dining", "commercial.beverage.boba", "commercial.hospitality.lounge"],
        "required_entities": ["table", "dining_surface"]
      },
      "inspection_queries": [
        {"query_id": "dining_surface_height_max", "target_role": "dining_surface", "metric": "height_inches", "threshold": 34.0, "comparison": "at_most", "citation": "ADA_2010_902.3", "rule_id": "dining_surface_height"},
        {"query_id": "dining_surface_height_min", "target_role": "dining_surface", "metric": "height_inches", "threshold": 28.0, "comparison": "at_least", "citation": "ADA_2010_902.3", "rule_id": "dining_surface_height"},
        {"query_id": "dining_knee_clearance_height", "target_role": "dining_surface", "metric": "knee_clearance_inches", "threshold": 27.0, "comparison": "at_least", "citation": "ADA_2010_306.3.1"},
        {"query_id": "dining_knee_clearance_width", "target_role": "dining_surface", "metric": "clear_width_inches", "threshold": 30.0, "comparison": "at_least", "citation": "ADA_2010_306.3.5"}
      ],
      "constraints": {
        "solution_pattern": "provide_accessible_dining_surfaces_among_general_seating",
        "requires_accessible_dining": true,
        "dispersed": true
      },
      "plain_english_warning": "At least 5 percent of the seating at tables and counters, and never less than one seat, must be at a surface 28 to 34 inches high with knee space at least 27 inches high and 30 inches wide underneath. Those accessible seats have to be spread among the other seating, not set apart by the door or the restroom.",
      "case_references": [
        {
          "citation": "117 F. Supp. 3d 1078 (N.D. Cal. 2015)",
          "case_name": "Kalani v. Starbucks Corp.",
          "court": "N.D. Cal.",
          "decided": "2015-07-28",
          "docket_number": "13-cv-00734-LHK",
          "source_url": "https://www.courtlistener.com/opinion/7314627/kalani-v-starbucks-corp/",
          "holding": "After a bench trial, the court held the store violated 42 U.S.C. 12182(b)(1) because its interior accessible tables left a wheelchair user facing the wall. It ordered at least one interior accessible table placed so a wheelchair user can sit facing into the store with their back to the wall.",
          "verified_by": null,
          "verified_at": null
        }
      ]
    },
    {
      "directive_id": "door_clearances",
      "title": "Door width, latch-side clearance and threshold",
      "authority": ["ADA_2010_404.2.3", "ADA_2010_404.2.4", "ADA_2010_404.2.5"],
      "trigger": {
        "space_typologies": ["commercial.office.private", "commercial.retail.mercantile", "commercial.restaurant.dining"],
        "required_entities": ["door", "entrance_door"]
      },
      "inspection_queries": [
        {"query_id": "door_clear_width", "target_role": "door", "metric": "clear_width_inches", "threshold": 32.0, "comparison": "at_least", "citation": "ADA_2010_404.2.3", "rule_id": "door_clear_width"},
        {"query_id": "door_pull_side_latch_clearance", "target_role": "door", "metric": "clear_width_inches", "threshold": 18.0, "comparison": "at_least", "citation": "ADA_2010_404.2.4.1", "rule_id": "door_maneuvering_clearance"},
        {"query_id": "door_threshold_height", "target_role": "door", "metric": "height_inches", "threshold": 0.5, "comparison": "at_most", "citation": "ADA_2010_404.2.5", "rule_id": "entrance_threshold"}
      ],
      "constraints": {
        "solution_pattern": "keep_door_maneuvering_clearance_free_of_furniture"
      },
      "plain_english_warning": "Doors need 32 inches of clear opening and, on the pull side, 18 inches of clear floor beside the latch. Cabinets, planters and desks cannot sit in that space. Thresholds can be at most half an inch high. Interior doors should open with no more than 5 pounds of push; the federal standard sets no limit for exterior doors.",
      "case_references": []
    },
    {
      "directive_id": "restroom_turning_space",
      "title": "Restroom turning space",
      "authority": ["ADA_2010_603.2.1", "ADA_2010_304.3.1"],
      "trigger": {
        "space_typologies": ["facility.restroom.single_user"],
        "required_entities": ["toilet", "sink", "trash_can"]
      },
      "inspection_queries": [
        {"query_id": "restroom_turning_circle", "target_role": "restroom", "metric": "clear_width_inches", "threshold": 60.0, "comparison": "at_least", "citation": "ADA_2010_304.3.1", "rule_id": "restroom_turning_space"}
      ],
      "constraints": {
        "solution_pattern": "clear_60_inch_turning_circle"
      },
      "plain_english_warning": "A single-user restroom needs a clear 60 inch circle to turn around in. Trash cans, hampers and carts left inside that circle block it.",
      "case_references": []
    },
    {
      "directive_id": "self_service_kiosk",
      "title": "Self-ordering kiosk reach and floor space",
      "authority": ["ADA_2010_309.3", "ADA_2010_308.2.1", "ADA_2010_305.3"],
      "trigger": {
        "space_typologies": ["commercial.beverage.boba", "commercial.restaurant.dining", "commercial.retail.mercantile"],
        "required_entities": ["ordering_kiosk", "terminal", "touchscreen"]
      },
      "inspection_queries": [
        {"query_id": "kiosk_operable_part_height", "target_role": "ordering_kiosk", "metric": "reach_inches", "threshold": 48.0, "comparison": "at_most", "citation": "ADA_2010_308.2.1", "rule_id": "reach_range"},
        {"query_id": "kiosk_clear_floor_width", "target_role": "ordering_kiosk", "metric": "clear_width_inches", "threshold": 30.0, "comparison": "at_least", "citation": "ADA_2010_305.3"}
      ],
      "constraints": {
        "solution_pattern": "provide_30_by_48_inch_clear_floor_space"
      },
      "plain_english_warning": "Kiosk screens, buttons and card readers must be reachable, no higher than 48 inches for a forward reach, with a clear 30 by 48 inch patch of floor in front.",
      "case_references": []
    },
    {
      "directive_id": "assembly_wheelchair_spaces",
      "title": "Wheelchair spaces in presentation rooms",
      "authority": ["ADA_2010_802.1.2", "ADA_2010_802.1.3", "ADA_2010_221.2.3"],
      "trigger": {
        "space_typologies": ["assembly.presentation_room", "civic.library.reading_room"],
        "required_entities": ["presentation_seating", "auditorium_row", "podium"]
      },
      "inspection_queries": [
        {"query_id": "wheelchair_space_width", "target_role": "presentation_seating", "metric": "clear_width_inches", "threshold": 36.0, "comparison": "at_least", "citation": "ADA_2010_802.1.2"},
        {"query_id": "wheelchair_space_depth", "target_role": "presentation_seating", "metric": "clear_length_inches", "threshold": 48.0, "comparison": "at_least", "citation": "ADA_2010_802.1.3"}
      ],
      "constraints": {
        "solution_pattern": "disperse_wheelchair_spaces_with_companion_seats"
      },
      "plain_english_warning": "Each wheelchair space needs to be at least 36 inches wide and 48 inches deep when entered from the front or back (60 inches deep from the side). The spaces have to be spread across the room, not all in the back row. The number required follows the table in 221.2.1.1, not a flat percentage.",
      "case_references": []
    }
  ]
}
