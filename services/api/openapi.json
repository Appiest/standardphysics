{
  "openapi": "3.1.0",
  "info": {
    "title": "Standard Physics upload contract",
    "version": "0.1.0",
    "description": "Lane A codes against this. Lane D implements it. packages/fixtures/standardphysics_fixtures/mock_api.py serves it locally on :8787. When the mock and this document disagree, this document wins."
  },
  "paths": {
    "/api/scans": {
      "post": {
        "summary": "Start a scan session",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["name", "device_model", "duration_seconds"],
                "properties": {
                  "name": {"type": "string"},
                  "device_model": {"type": "string"},
                  "duration_seconds": {"type": "number"},
                  "replaces": {"type": "string", "format": "uuid", "description": "A shop this walk joins. The new walk replaces that scan once it is in, and keeps the owner's in-shop answers and photos."}
                }
              }
            }
          }
        },
        "responses": {
          "201": {"description": "Scan created", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Scan"}}}}
        }
      },
      "get": {
        "summary": "List scans",
        "responses": {"200": {"description": "Scans"}}
      }
    },
    "/api/scans/{scan_id}/artifacts/{artifact_id}": {
      "put": {
        "summary": "Upload one artifact, idempotently",
        "description": "Re-uploading the same artifact_id returns 200 with the stored artifact and does not duplicate it. This is artifact-level resume, not byte-range resume.",
        "parameters": [
          {"name": "scan_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
          {"name": "artifact_id", "in": "path", "required": true, "schema": {"type": "string"}},
          {"name": "X-Checksum-SHA256", "in": "header", "required": true, "schema": {"type": "string"}},
          {"name": "X-Artifact-Kind", "in": "header", "required": true, "schema": {"$ref": "#/components/schemas/ArtifactKind"}}
        ],
        "requestBody": {"required": true, "content": {"application/octet-stream": {"schema": {"type": "string", "format": "binary"}}}},
        "responses": {
          "201": {"description": "Stored"},
          "200": {"description": "Already stored"},
          "400": {"description": "Checksum mismatch"}
        }
      }
    },
    "/api/scans/{scan_id}/complete": {
      "post": {
        "summary": "Finalize the upload and queue processing",
        "description": "Idempotent. Requires room_usdz and room_json. The optional body lets a new client declare what it believes it finished; the server decides from stored bytes, so a legacy call with no body behaves exactly as before. Geometry can be ready while photo evidence is still incomplete; GET /api/scans/{scan_id}/evidence says which.",
        "parameters": [{"name": "scan_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}],
        "requestBody": {
          "required": false,
          "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CompleteRequest"}}}
        },
        "responses": {
          "200": {"description": "Queued", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Scan"}}}},
          "409": {"description": "Missing required artifacts"}
        }
      }
    },
    "/api/scans/{scan_id}/evidence": {
      "get": {
        "summary": "Geometry, evidence and semantic readiness of a scan",
        "parameters": [{"name": "scan_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}],
        "responses": {
          "200": {"description": "Readiness", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/EvidenceStatus"}}}}
        }
      }
    },
    "/api/scans/{scan_id}/revisions/{base_revision}/observations": {
      "put": {
        "summary": "Store a person's manual photo mark for a target the pipeline did not find",
        "description": "With node_id the mark attaches to that measured object's evidence; without one it is stored unlocalized. Manual marks keep their actor and time and are never reported as automatic detections.",
        "parameters": [
          {"name": "scan_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
          {"name": "base_revision", "in": "path", "required": true, "schema": {"type": "integer"}}
        ],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ManualMarkRequest"}}}},
        "responses": {
          "201": {"description": "Saved revision with the observation"},
          "404": {"description": "Unknown scan, revision or node"},
          "409": {"description": "Stale base revision"}
        }
      }
    },
    "/api/scans/{scan_id}/lidar-mesh": {
      "get": {
        "summary": "Get the raw captured LiDAR mesh",
        "parameters": [{"name": "scan_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}],
        "responses": {
          "200": {"description": "Raw LiDAR mesh JSON", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/LidarMesh"}}}},
          "404": {"description": "Scan or mesh is not available"}
        }
      }
    },
    "/api/scans/{scan_id}": {
      "get": {
        "summary": "Poll scan state",
        "parameters": [{"name": "scan_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}],
        "responses": {"200": {"description": "Scan", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Scan"}}}}}
      }
    }
  },
  "components": {
    "schemas": {
      "ArtifactKind": {
        "type": "string",
        "enum": ["room_usdz", "room_json", "room_metadata", "walkthrough_mp4", "frames", "poses", "coverage", "lidar_mesh", "photo_manifest"]
      },
      "ScanState": {
        "type": "string",
        "enum": ["uploading", "measuring", "checking", "ready", "failed"],
        "description": "The app shows these as Uploading, Measuring your shop, Checking, Ready. Ready on this state does not mean photo recognition used complete evidence; see EvidenceStatus."
      },
      "CompleteRequest": {
        "type": "object",
        "properties": {
          "declared_complete": {"type": "boolean"},
          "manifest_hash": {"type": ["string", "null"]},
          "client_version": {"type": ["string", "null"]}
        }
      },
      "EvidenceStatus": {
        "type": "object",
        "required": ["scan_id", "geometry_state", "evidence_state", "semantic_state"],
        "properties": {
          "scan_id": {"type": "string", "format": "uuid"},
          "geometry_state": {"type": "string", "enum": ["awaiting", "ready", "failed"]},
          "evidence_state": {"type": "string", "enum": ["awaiting", "partial", "complete", "incomplete"]},
          "semantic_state": {"type": "string", "enum": ["not_started", "blocked_incomplete_evidence", "settling", "queued", "running", "complete", "failed"]},
          "present_kinds": {"type": "array", "items": {"type": "string"}},
          "missing_geometry_kinds": {"type": "array", "items": {"type": "string"}},
          "missing_semantic_kinds": {"type": "array", "items": {"type": "string"}},
          "reasons": {"type": "array", "items": {"type": "string"}},
          "bundle_version": {"type": "integer"},
          "manifest_hash": {"type": ["string", "null"]},
          "complete_evidence": {"type": "boolean"},
          "semantic_job_pending": {"type": "boolean"}
        }
      },
      "ManualMarkRequest": {
        "type": "object",
        "required": ["target_class", "frame_id", "sensor_box"],
        "properties": {
          "target_class": {"type": "string", "enum": ["outlet", "television", "service_counter", "restroom_entrance", "sofa", "table", "whiteboard", "monitor", "other"]},
          "frame_id": {"type": "string"},
          "sensor_box": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}},
          "node_id": {"type": ["string", "null"], "format": "uuid"},
          "note": {"type": ["string", "null"]},
          "review_status": {"type": "string", "enum": ["candidate", "confirmed_by_user"]}
        }
      },
      "Artifact": {
        "type": "object",
        "required": ["id", "kind", "sha256", "bytes"],
        "properties": {
          "id": {"type": "string"},
          "kind": {"$ref": "#/components/schemas/ArtifactKind"},
          "sha256": {"type": "string"},
          "bytes": {"type": "integer"},
          "stored_path": {"type": ["string", "null"]}
        }
      },
      "Scan": {
        "type": "object",
        "required": ["id", "name", "created_at", "device_model", "duration_seconds", "state"],
        "properties": {
          "id": {"type": "string", "format": "uuid"},
          "name": {"type": "string"},
          "created_at": {"type": "string", "format": "date-time"},
          "device_model": {"type": "string"},
          "duration_seconds": {"type": "number"},
          "state": {"$ref": "#/components/schemas/ScanState"},
          "artifacts": {"type": "array", "items": {"$ref": "#/components/schemas/Artifact"}}
        }
      },
      "LidarMeshPart": {
        "type": "object",
        "required": ["id", "transform", "vertices", "triangles"],
        "properties": {
          "id": {"type": "string", "format": "uuid"},
          "transform": {"type": "array", "minItems": 16, "maxItems": 16, "items": {"type": "number"}},
          "vertices": {"type": "array", "items": {"type": "number"}},
          "triangles": {"type": "array", "items": {"type": "integer"}}
        }
      },
      "LidarMesh": {
        "type": "object",
        "required": ["parts"],
        "properties": {
          "parts": {"type": "array", "minItems": 1, "items": {"$ref": "#/components/schemas/LidarMeshPart"}},
          "peopleFilteringEnabled": {"type": ["boolean", "null"]},
          "floorY": {"type": ["number", "null"]}
        }
      }
    }
  }
}
